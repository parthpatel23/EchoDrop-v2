PORT=5000
MONGO_URI=
JWT_SECRET=

# Base URL for backend (used in OAuth callbacks)
BASE_URL=http://localhost:5000

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:4200

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# IMPORTANT: This should match your Google Cloud Console authorized redirect URI
GOOGLE_REDIRECT_URI=

# Email (sender address for OAuth-based Gmail sending)
EMAIL_USER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS Number (for normal text messages)
TWILIO_SMS_PHONE=

# WhatsApp Sandbox Number
TWILIO_WHATSAPP_PHONE=

# Telegram Bot (for personal reminders)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
